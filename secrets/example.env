# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=symbology

# Better Auth (UI). BETTER_AUTH_SECRET must be a long random string
# (e.g. `openssl rand -base64 32`). BETTER_AUTH_URL is the app's public origin.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# PUBLIC_UMAMI_SCRIPT_URL=
# PUBLIC_UMAMI_WEBSITE_ID=

# OpenAI-compatible embedding endpoint (e.g. Jina embedding server)
OPENAI_API_HOST=localhost
OPENAI_API_PORT=11434
OPENAI_API_KEY=not-needed
OPENAI_EMBEDDING_MODEL=jina-embeddings-v5-omni-small-retrieval
OPENAI_EMBEDDING_DIMENSIONS=1024
# OPENAI_EMBEDDING_BATCH_SIZE=32
# OPENAI_CHUNK_SIZE=2000
# OPENAI_CHUNK_OVERLAP=200

# Dynamic context sizing via the LM Studio model-load API. Enable to (re)load
# the served model with a context window sized to each request, so oversized
# filing sections (e.g. risk_factors) don't overflow a fixed window and abort
# the pipeline. Reuses OPENAI_API_KEY as the bearer token.
# OPENAI_MANAGE_CONTEXT=true
# OPENAI_MANAGEMENT_PATH=/api/v1
# OPENAI_CONTEXT_MIN=4096
# OPENAI_CONTEXT_MAX=32768
# OPENAI_CONTEXT_BUCKET=4096
# OPENAI_CHARS_PER_TOKEN=3.5
# OPENAI_CONTEXT_SAFETY_MARGIN=1.15
# OPENAI_MODEL_LOAD_TIMEOUT=300

# Offload prompts whose estimated size exceeds this many tokens to Anthropic
# (which has a far larger context) instead of the local model. Set 0 to disable.
# OPENAI_OVERFLOW_MODEL empty -> falls back to ANTHROPIC_DEFAULT_MODEL. Requires
# ANTHROPIC_API_KEY to be set.
# OPENAI_OVERFLOW_THRESHOLD_TOKENS=45000
# OPENAI_OVERFLOW_MODEL=claude-haiku-4-5-20251001

