set dotenv-load

deps:
  npm ci

up:
  npm run dev -- --open --host 0.0.0.0

# Auto-format, apply lint fixes, then type-check. Each step is its own npm
# script so a failure points at the exact tool; `just` stops on the first
# non-zero line.
lint: format
  npm run check

# Auto-format and apply lint fixes (no type-check).
format:
  npm run format
  npm run eslint

# Read-only gate for CI: fail on formatting drift, lint problems, or type
# errors — nothing is rewritten. Mirrors `lint` but in check mode.
lint-check:
  npm run format:check
  npm run eslint:check
  npm run check


# Config is auto-discovered from src/lib/server/auth.ts; -y skips the interactive
# confirmation so it's automation-safe. Run after the `auth` schema exists
# (Alembic r7b8c9d0e1f2) — repo-root `just db-init` sequences this.
#
# Create/upgrade Better Auth's tables (user/session/account/verification).
auth-migrate:
  npx @better-auth/cli migrate -y

generate-db-types:
  npx kysely-codegen --url "postgresql://${DATABASE_USER:-postgres}:${DATABASE_PASSWORD:-postgres}@${DATABASE_HOST:-localhost}:${DATABASE_PORT:-5432}/${DATABASE_NAME:-symbology}" --out-file src/lib/server/db/types.ts --dialect postgres


build:
  ~/.local/bin/nerdctl build . -t symbology-ui:latest
  ~/.local/bin/nerdctl save symbology-ui:latest -o symbology-ui-latest.tar
